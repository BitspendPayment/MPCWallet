// This template's variable requirements — SELF-DOCUMENTING: an author reading this WIT sees
// exactly what to provide (an oracle-token blob + a max-sats ceiling). A TEMPLATE imports this
// interface; the cosigner synthesizes a matching PROVIDER (by patching the author's values into
// the template's published provider stub) and composes it in.
package oracle:gate@0.1.0;

interface config {
    /// The oracle packet the spender must present (in contract-args) to be authorized.
    oracle-token: func() -> list<u8>;
    /// Maximum total output value (sats) this contract authorizes.
    max-sats: func() -> u64;
}
