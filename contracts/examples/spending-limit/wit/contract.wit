// Canonical contract ABI — must stay identical to cosigner-runtime/wit/contract.wit.
package bitcoin:contract@0.1.0;

interface tx {
    record outpoint { txid: list<u8>, vout: u32 }
    record txin {
        prevout: outpoint,
        sequence: u32,
        script-sig: list<u8>,
        witness: list<list<u8>>,
    }
    record txout { value: u64, script-pubkey: list<u8> }
    record prevout-info { value: u64, script-pubkey: list<u8> }
    record transaction {
        version: s32,
        lock-time: u32,
        inputs: list<txin>,
        outputs: list<txout>,
    }
    record eval-context {
        tx: transaction,
        prevouts: list<prevout-info>,
        input-index: u32,
        contract-args: list<u8>,
    }
    variant verdict { allow, deny(string) }
}

interface crypto {
    sha256: func(data: list<u8>) -> list<u8>;
    hash256: func(data: list<u8>) -> list<u8>;
    ripemd160: func(data: list<u8>) -> list<u8>;
    hash160: func(data: list<u8>) -> list<u8>;
    tagged-hash: func(tag: string, msg: list<u8>) -> list<u8>;
    schnorr-verify: func(pubkey: list<u8>, msg: list<u8>, sig: list<u8>) -> bool;
}

world contract {
    use tx.{eval-context, verdict};
    import crypto;
    export evaluate: func(ctx: eval-context) -> verdict;
}
