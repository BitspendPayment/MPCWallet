// The PROVIDER stub for the oracle-gate template: exports `oracle:gate/config`. The interface MUST
// be byte-identical to the template's imported one so the composer wires this export into the
// template's import. Each typed getter reads its value from a patchable key-value slot the cosigner
// stamps with the author's values. (An SDK macro generates this stub from the template's schema.)
package oracle:gate@0.1.0;

interface config {
    oracle-token: func() -> list<u8>;
    max-sats: func() -> u64;
}

world provider {
    export config;
}
