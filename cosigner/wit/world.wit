package cosigner:guest@0.1.0;

interface contract-gate {
  // Host capability: evaluate the contract bound to the spend being signed, over the
  // full transaction the guest holds, in the host's isolated sandbox. The guest calls
  // this from inside FROST signing and refuses to produce its share on Deny.
  enforce: func(full-tx: list<u8>) -> result<_, string>;
}

interface asp-gate {
  // ASP gRPC transport — host only. The guest owns the Ark flow + keys and drives it,
  // delegating each network round-trip to the host (which holds the tonic AspClient).
  record submit-tx-response {
    ark-txid: string,
    signed-checkpoint-txs: list<string>,
  }
  // Returns serialized ArkInfo (JSON bytes); the guest deserializes it.
  get-info: func() -> result<list<u8>, string>;
  submit-tx: func(ark-tx-b64: string, checkpoint-txs-b64: list<string>) -> result<submit-tx-response, string>;
  finalize-tx: func(ark-txid: string, final-checkpoint-txs-b64: list<string>) -> result<_, string>;
}

world cosigner-guest {
  import contract-gate;
  import asp-gate;
  // Single async request/response entry point. Request/response bodies are
  // serialized cosigner-proto GuestCommand/GuestResponse.
  export handle: func(request: list<u8>) -> list<u8>;
}
