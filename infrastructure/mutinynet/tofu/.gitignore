# Never commit: holds WEBAUTH_TOKEN_SECRET and the FCM service account.
secrets.auto.tfvars.json
*.auto.tfvars.json
terraform.tfvars
terraform.tfvars.json

# Local state (this stack has no remote backend configured yet).
*.tfstate
*.tfstate.*
.terraform/
crash.log

# .terraform.lock.hcl is deliberately NOT ignored — committing the provider
# lock is what makes an apply reproducible across machines.
